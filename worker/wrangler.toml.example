name = "bookmarks"
main = "src/index.ts"
compatibility_date = "2025-05-12"

# Cloudflare Dashboard/Workers bindings must use these exact variable names.
# Runtime variables/secrets are not required for this project.

[[durable_objects.bindings]]
name = "SYNC_CHANNEL"
class_name = "SyncChannel"

[[migrations]]
tag = "v1"
new_sqlite_classes = [ "SyncChannel" ]

# v2: one SQLite Durable Object per sync group + a global registry for pairing codes
[[durable_objects.bindings]]
name = "SYNC_GROUP"
class_name = "SyncGroup"

[[durable_objects.bindings]]
name = "REGISTRY"
class_name = "Registry"

[[migrations]]
tag = "v2"
new_sqlite_classes = [ "SyncGroup", "Registry" ]

[[d1_databases]]
# Binding variable name used by code: env.DB
binding = "DB"
database_name = "bookmarks-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[[kv_namespaces]]
# Binding variable name used by code: env.BOOKMARKS_KV
binding = "BOOKMARKS_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

[observability]
enabled = true

