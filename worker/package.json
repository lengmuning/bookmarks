{
  "name": "safari-bookmarks-sync",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "wrangler d1 execute bookmarks-db --file=migrations/001_schema.sql",
    "db:migrate:device-tokens": "wrangler d1 execute bookmarks-db --file=migrations/002_device_tokens.sql",
    "db:migrate:folder-paths": "wrangler d1 execute bookmarks-db --file=migrations/003_folder_paths.sql",
    "db:migrate:canonical-state": "wrangler d1 execute bookmarks-db --file=migrations/004_canonical_state.sql"
  },
  "dependencies": {
    "itty-router": "^5.0.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^22.20.4",
    "@vitest/runner": "~4.1.0",
    "@vitest/snapshot": "~4.1.0",
    "typescript": "^5.7.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.136.3"
  }
}
