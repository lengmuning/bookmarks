{
  "name": "safari-bookmarks-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:migrate": "wrangler d1 execute bookmarks-db --file=migrations/001_schema.sql",
    "db:migrate:device-tokens": "wrangler d1 execute bookmarks-db --file=migrations/002_device_tokens.sql",
    "db:migrate:folder-paths": "wrangler d1 execute bookmarks-db --file=migrations/003_folder_paths.sql"
  },
  "dependencies": {
    "itty-router": "^5.0.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250501.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.2.0"
  }
}
