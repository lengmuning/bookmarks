{
  "manifest_version": 3,
  "name": "Safari Bookmarks Sync",
  "version": "1.0.0",
  "description": "Receive Safari bookmarks synced via Cloudflare",
  "browser_specific_settings": {
    "gecko": {
      "id": "safari-bookmarks-sync@example.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bookmarks Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
